#!/bin/sh
# Nuvio Remote daemon - init script for rooted webOS TVs (Homebrew Channel).
# Installed as /var/lib/webosbrew/init.d/nuvio-remote; the Homebrew Channel runs every script
# in that directory at boot (run-parts: no dots in the file name).
#
#   nuvio-remote [start|stop|restart|status]   (no argument = start, as run-parts calls it)

BASE=/var/lib/nuvio-remote
APP="$BASE/daemon/main.js"
PIDFILE=/tmp/nuvio-remote.pid
LOG=/tmp/nuvio-remote.log
MAX_LOG_BYTES=1048576

find_node() {
  for candidate in /usr/bin/node /usr/local/bin/node /usr/bin/nodejs; do
    [ -x "$candidate" ] && { echo "$candidate"; return 0; }
  done
  command -v node 2>/dev/null
}

running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

supervise() {
  node="$1"
  while [ -f "$PIDFILE" ]; do
    if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt "$MAX_LOG_BYTES" ]; then
      mv "$LOG" "$LOG.1"
    fi
    "$node" "$APP" --state "$BASE/state.json" >> "$LOG" 2>&1
    echo "$(date) daemon exited ($?), restarting in 5 s" >> "$LOG"
    sleep 5
  done
}

start() {
  if running; then
    echo "nuvio-remote already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  node="$(find_node)"
  if [ -z "$node" ]; then
    echo "nuvio-remote: no node binary found" | tee -a "$LOG"
    return 1
  fi
  echo $$ > "$PIDFILE"
  supervise "$node" < /dev/null > /dev/null 2>&1 &
  echo $! > "$PIDFILE"
  echo "nuvio-remote started (pid $!, node $node, log $LOG)"
}

stop() {
  if ! running; then
    echo "nuvio-remote not running"
    rm -f "$PIDFILE"
    return 0
  fi
  pid="$(cat "$PIDFILE")"
  rm -f "$PIDFILE"
  kill "$pid" 2>/dev/null
  pkill -f "$APP" 2>/dev/null
  echo "nuvio-remote stopped"
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status)
    if running; then echo "running (pid $(cat "$PIDFILE"))"; else echo "stopped"; fi
    tail -n 20 "$LOG" 2>/dev/null
    ;;
  *) echo "usage: $0 [start|stop|restart|status]"; exit 1 ;;
esac
